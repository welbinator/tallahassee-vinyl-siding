---
export interface Props {
  title?: string;
  description?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const {
  title = "Tallahassee Vinyl Siding | GCE Improvements",
  description = "Vinyl siding installation and repair in Tallahassee, FL. Licensed, bonded general contractor with 20+ years experience. Siding, screen rooms, gutters, soffit, fascia, and decks. Free estimates.",
} = Astro.props;
const isStaging = base !== "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script>
      document.documentElement.classList.add("js");
      const risers = Array.from(document.querySelectorAll(".rise"));
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }), { rootMargin: "0px 0px -6% 0px", threshold: 0.06 });
      risers.forEach((el) => io.observe(el));
      setTimeout(() => risers.forEach((el) => el.classList.add("in")), 1400);

      const toggle = document.querySelector(".nav-toggle");
      const menu = document.getElementById("nav-menu");
      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const open = menu.hasAttribute("hidden");
          if (open) menu.removeAttribute("hidden"); else menu.setAttribute("hidden", "");
          toggle.setAttribute("aria-expanded", String(open));
        });
      }
    </script>
    <style is:global>
      :root {
        --paper: #f6f4ef;
        --paper-2: #efece4;
        --ink: #17201c;
        --ink-soft: #46514b;
        --line: #dcd7cc;
        --ever: #1f6b4a;
        --ever-deep: #17533a;
        --ever-bright: #28976a;
        --sand: #e8b45a;
        --white: #ffffff;
        --font-display: "Hanken Grotesk", system-ui, sans-serif;
        --font-body: "Inter", system-ui, sans-serif;
        --wrap: 1120px;
        --radius: 14px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font-family: var(--font-body); font-size: 17px; line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 { font-family: var(--font-display); line-height: 1.08; margin: 0; letter-spacing: -0.02em; }
      h1 { font-size: clamp(2.3rem, 6vw, 4rem); font-weight: 800; }
      h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); font-weight: 700; }
      h3 { font-size: 1.3rem; font-weight: 700; }
      p { margin: 0; }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      .wrap { width: 100%; max-width: var(--wrap); margin: 0 auto; padding: 0 1.4rem; }

      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center;
        font-family: var(--font-display); font-weight: 700; font-size: 1.02rem;
        padding: 0.85rem 1.5rem; border-radius: 10px; border: 2px solid transparent;
        cursor: pointer; transition: transform .15s, background .15s, box-shadow .15s;
      }
      .btn-primary { background: var(--ever); color: var(--white); }
      .btn-primary:hover { background: var(--ever-deep); transform: translateY(-2px); box-shadow: 0 10px 22px rgba(31,107,74,.25); }
      .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
      .btn-ghost:hover { border-color: var(--ever); color: var(--ever-deep); }

      .eyebrow {
        font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.12em; font-size: 0.82rem; color: var(--ever-deep);
      }

      .rise { }
      html.js .rise { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
      html.js .rise.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { html.js .rise, .rise { opacity: 1 !important; transform: none !important; transition: none; } }

      /* NAV */
      .nav { position: sticky; top: 0; z-index: 50; background: rgba(246,244,239,.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; padding-top: 0.8rem; padding-bottom: 0.8rem; }
      .brand { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
      .brand .mark { width: 34px; height: 34px; }
      .nav-links { display: flex; align-items: center; gap: 1.6rem; }
      .nav-links a { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; color: var(--ink-soft); }
      .nav-links a:hover { color: var(--ever-deep); }
      .nav-phone { font-family: var(--font-display); font-weight: 800; color: var(--ever-deep); }
      .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
      .nav-toggle span { width: 24px; height: 2px; background: var(--ink); display: block; }
      @media (max-width: 860px) {
        .nav-toggle { display: flex; }
        .nav-links {
          position: absolute; top: 100%; left: 0; right: 0; flex-direction: column;
          align-items: flex-start; gap: 0.4rem; background: var(--paper); border-bottom: 1px solid var(--line);
          padding: 1rem 1.4rem 1.4rem;
        }
        .nav-links[hidden] { display: none !important; }
      }

      footer { background: var(--ink); color: #cdd6d0; margin-top: 4rem; }
      footer a { color: #cdd6d0; }
      footer a:hover { color: var(--white); }
    </style>
  </body>
</html>
